@{
    ViewData["Title"] = "Home";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Brain Flow</title>
    <link rel="stylesheet" href="~/css/fronted/style.css" />
</head>
<body>
    <!-- Header -->
    <header class="nav">
        <div class="wrap">
            <div class="brand">
                <img src="~/img/logo_branco.svg" width="128" height="128" alt="Brain Flow">
            </div>
            <nav class="menu">
                <a href="@Url.Action("Index", "Home")">Home</a>
                <a href="@Url.Action("Cursos", "Home")">Cursos</a>
                <a href="@Url.Action("Login", "Conta")">Login</a>
                <a class="signup" href="@Url.Action("Cadastro", "Conta")">Cadastro</a>
            </nav>
        </div>
    </header>

    <!-- Hero -->
    <section class="hero">
        <div class="wrap hero-inner">
            <h1>Aprenda com cursos que cabem no seu tempo</h1>
            <p class="sub">Busque por tema, professor ou palavra-chave.</p>
            <div class="search-wrap hero-search">
                <input class="search" type="search" name="q" placeholder="Ex.: programação, design, marketing..." />
            </div>
        </div>
    </section>

    <main class="page">
        <div class="grid">
            <!-- Destaques -->
            <h2 class="section-title">Cursos em destaque</h2>

            <div class="hscroll" aria-label="Cursos em destaque">
                <div class="hcards" id="destaques">
                    @if (ViewBag.CursosDestaque != null && ((List<BrainFlow.UI.Web.Controllers.MockCursoMOD>)ViewBag.CursosDestaque).Any())
                    {
                        @foreach (var curso in (List<BrainFlow.UI.Web.Controllers.MockCursoMOD>)ViewBag.CursosDestaque)
                        {
                            <article class="course-card">
                                <div class="thumb" style="background-image:url('@(string.IsNullOrEmpty(curso.TxCaminhoImagem) ? "/img/placeholder-course.jpg" : curso.TxCaminhoImagem)'); background-size:cover; background-position:center"></div>
                                <div class="course-main">
                                    <h3 class="title">@curso.NoCurso</h3>
                                    <p class="desc">@(curso.TxDescricao.Length > 100 ? curso.TxDescricao.Substring(0, 100) + "..." : curso.TxDescricao)</p>
                                    <div class="course-footer">
                                        <span class="price">@(curso.DcValor == 0 ? "Gratuito" : $"R$ {curso.DcValor:N2}")</span>
                                        <a class="btn small" href="@Url.Action("Detalhes", "Curso", new { id = curso.CdCurso })">Ver curso</a>
                                    </div>
                                </div>
                            </article>
                        }
                    }
                    else
                    {
                        <!-- Mensagem de estado vazio -->
                        <p class="sub" style="margin-top:10px">Nenhum curso em destaque no momento.</p>
                    }
                </div>
            </div>

            <!-- Banner simples -->
            <section class="promo">
                <div class="promo-card">
                    <div>
                        <h3>Vire afiliado do Brain Flow</h3>
                        <p class="desc">Monetize divulgando cursos e acompanhe suas comissões.</p>
                    </div>
                    <a class="btn primary" href="@Url.Action("Cadastro", "Conta")">Criar conta</a>
                </div>
            </section>

            <!-- Categorias -->
            <h2 class="section-title">Categorias</h2>
            <div class="cat-grid" id="categorias">
                @if (ViewBag.Categorias != null && ((List<string>)ViewBag.Categorias).Any())
                {
                    @foreach (var categoria in (List<string>)ViewBag.Categorias)
                    {
                        <a class="cat-card" href="@Url.Action("Cursos", "Home", new { categoria = categoria })">
                            <span class="cat-name">@categoria</span>
                        </a>
                    }
                }
                else
                {
                    <!-- Mensagem de estado vazio -->
                    <p class="sub" style="margin-top:10px">Categorias indisponíveis no momento.</p>
                }
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="wrap footer-inner">
            <span>© Brain Flow</span>
            <nav class="footer-nav">
                <a href="#sobre">Sobre</a>
                <a href="#suporte">Suporte</a>
                <a href="#termos">Termos</a>
            </nav>
        </div>
    </footer>

    <script src="~/js/site.js"></script>
    @if (TempData["Modal-Sucesso"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                showToast('@TempData["Modal-Sucesso"]', 'success');
            });
        </script>
    }
    @if (TempData["Modal-Erro"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                showToast('@TempData["Modal-Erro"]', 'error');
            });
        </script>
    }
</body>
</html>
